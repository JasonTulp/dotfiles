{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Install the CLI tools the shell/tmux/nvim configs expect. Only installs what's missing.
set -euo pipefail

# command -> package name
declare -A pkgs=(
  [zsh]=zsh [git]=git [curl]=curl [tmux]=tmux [nvim]=neovim
  [fzf]=fzf [zoxide]=zoxide [unzip]=unzip
)

missing=()
for cmd in "${!pkgs[@]}"; do
  command -v "$cmd" >/dev/null || missing+=("${pkgs[$cmd]}")
done

sudo=""
[ "$(id -u)" -ne 0 ] && sudo="sudo"

install_missing() {
  if command -v pacman >/dev/null; then
    $sudo pacman -S --needed --noconfirm "${missing[@]}"
  elif command -v apt-get >/dev/null; then
    $sudo apt-get update && $sudo apt-get install -y "${missing[@]}"
  elif command -v dnf >/dev/null; then
    $sudo dnf install -y "${missing[@]}"
  else
    return 1
  fi
}

# A failed install (no sudo, wrong password) shouldn't stop configs being linked.
if [ ${#missing[@]} -gt 0 ]; then
  echo "Installing: ${missing[*]}"
  if ! install_missing; then
    echo "WARNING: could not install: ${missing[*]}" >&2
    echo "Install them manually, then run: chezmoi state delete-bucket --bucket=scriptState && chezmoi apply" >&2
  fi
fi

# starship isn't packaged everywhere, use the upstream installer into ~/.local/bin
if ! command -v starship >/dev/null; then
  mkdir -p "$HOME/.local/bin"
  curl -sS https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"
fi

# herdr ships as a single static binary on GitHub releases
if ! command -v herdr >/dev/null; then
  mkdir -p "$HOME/.local/bin"
  curl -fsSL -o "$HOME/.local/bin/herdr" \
    "https://github.com/herdrdev/herdr/releases/latest/download/herdr-linux-$(uname -m)"
  chmod +x "$HOME/.local/bin/herdr"
fi

# No zsh from the package manager (e.g. no sudo): use romkatv's static build in ~/.local
if ! command -v zsh >/dev/null && [ ! -x "$HOME/.local/bin/zsh" ]; then
  installer=$(mktemp)
  curl -fsSL -o "$installer" https://raw.githubusercontent.com/romkatv/zsh-bin/master/install
  sh "$installer" -q -d "$HOME/.local" -e no -a sha256
  rm -f "$installer"
fi

zsh_path=$(command -v zsh || echo "$HOME/.local/bin/zsh")
if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
  if grep -qxF "$zsh_path" /etc/shells 2>/dev/null; then
    echo "Default shell is ${SHELL:-unknown}. Switch with: chsh -s $zsh_path"
  elif ! grep -qF '# >>> dotfiles: exec zsh' "$HOME/.bashrc" 2>/dev/null; then
    # zsh isn't an allowed login shell here, so have interactive bash (incl. ssh logins) hand over.
    # Escape hatch: ssh -t <host> bash --norc
    cat >>"$HOME/.bashrc" <<EOF

# >>> dotfiles: exec zsh >>>
if [[ \$- == *i* && -z "\$ZSH_VERSION" && -x "$zsh_path" ]]; then
  export SHELL="$zsh_path"
  exec "\$SHELL" -l
fi
# <<< dotfiles: exec zsh <<<
EOF
    echo "Added zsh hand-off to ~/.bashrc"
  fi
fi
{{ end -}}
