QListView::item:selected,
QTreeView::item:selected {
    background-color: #353535;
    border-left: 3px solid #e08b0b;
    color: #d4d4d4;
}

QListView::item:hover,
QTreeView::item:hover {
    background-color: #2a2a2a;
}

QStatusBar {
    min-height: 32px;
    padding: 4px 0px;
}

QStatusBar QLabel {
    padding: 2px 4px;
}
