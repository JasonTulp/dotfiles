# Shared TV settings, sourced by game-mode.sh, tv-send.sh and session-switch.sh.

# Connector the wall run to the TV is plugged into.
TV_MONITOR=HDMI-A-1
TV_WORKSPACE=name:TV

# The GPU exposes one HDMI audio sink at a time, so game mode has to switch the
# card profile as well as the default sink. Profile 3 is the HDMI connector;
# profiles 0-2 are the three DisplayPort monitors.
# Run `game-mode.sh sinks` to re-check the mapping if the cabling changes.
TV_AUDIO_CARD=alsa_card.pci-0000_01_00.1
TV_AUDIO_PROFILE=output:hdmi-stereo-extra3
TV_SINK=alsa_output.pci-0000_01_00.1.hdmi-stereo-extra3

# Monitor that mirrors the TV for tv-mirror.sh. Its own geometry is read live
# and put back by re-reading monitors.lua, so it is not duplicated here.
MIRROR_MONITOR=DP-1

# What gamescope renders at. Must match the mode monitors.lua gives the TV, or
# gamescope's output gets rescaled by Hyprland for nothing. The TV's EDID caps
# TMDS at 300 MHz, which is HDMI 1.4 bandwidth, so 4K is only offered at 30 Hz
# and 1080p60 is the fastest mode the panel will take.
TV_GAMESCOPE_WIDTH=1920
TV_GAMESCOPE_HEIGHT=1080
TV_GAMESCOPE_REFRESH=60

# hyprland.lua sets SDL_VIDEODRIVER=wayland globally for Unity games, and that
# would follow Steam into the nest, where the supported path is gamescope's own
# XWayland. gamescope clears the variable for its children anyway, so with
# WAYLAND_DISPLAY also unset SDL lands on x11 by itself; this just states the
# intent and covers a gamescope that stops clearing it.
TV_STEAM_SDL_VIDEODRIVER=x11
